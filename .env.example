# Copy to .env for local development. Never commit .env - repo-sanity.mjs
# rejects it. In production these live in systemd's EnvironmentFile
# (see deploy/grange.service).

# Days a login session stays valid before it must be signed in again.
SESSION_TTL_DAYS=30

# Required to call POST /api/reset when NODE_ENV=production. The endpoint wipes
# game state and all accounts, so it refuses unauthenticated calls in production.
# Generate with: openssl rand -hex 32
RESET_KEY=

# Public base URL used to build the verification and password-reset links that
# go in emails. No trailing slash.
APP_URL=http://localhost:3000

# Transactional email (Mailjet). Required in production: without these the
# server refuses to start, because dropping verification mail would lock every
# account out. In dev/test they are optional; when unset, mail is logged to the
# console and can be read back from GET /api/auth/mailbox (non-production only).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Grange
